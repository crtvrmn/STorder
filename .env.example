# Storder – Beispielkonfiguration
# Kopieren nach .env und Werte anpassen:  cp .env.example .env

# --- KI (Pflicht für Foto-Analyse) -------------------------------------------
# OpenRouter-Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Jeder OpenAI-kompatible Endpunkt funktioniert (z. B. eigener llama.cpp/Ollama).
LLM_BASE_URL=https://openrouter.ai/api/v1

# Modelle (Vision = Bilderkennung, Web = Internet-Recherche)
LLM_MODEL=google/gemini-2.5-flash
LLM_VISION_MODEL=google/gemini-2.5-flash
LLM_WEB_MODEL=google/gemini-2.5-flash

# OpenRouter-Websuche-Plugin (Produktdaten aus dem Internet)
LLM_WEB_SEARCH=true
LLM_WEB_SEARCH_ENGINE=exa
LLM_WEB_RESULTS=4

# Bildersuche für zusätzliche Fotos (Standard: Wikimedia Commons, kein Key)
# IMAGE_SEARCH_PROVIDER=wikimedia   # oder openverse / auto
# IMAGE_SEARCH_RESULTS=12
# Bilder werden auf max. 1000 px verkleinert und als WebP gespeichert
# LLM_MAX_IMAGE_DIM=1000

# --- Paperless-ngx im lokalen Netz (Rechnungen suchen) ----------------------
# URL z. B. http://192.168.1.50:8000
PAPERLESS_URL=
# Variante A: API-Token (Paperless -> Einstellungen -> Users & Groups -> Benutzer -> API Token)
PAPERLESS_TOKEN=
# Variante B: Benutzername/Passwort (Storder holt den Token selbst über /api/token/)
PAPERLESS_USERNAME=
PAPERLESS_PASSWORD=
PAPERLESS_RESULTS=8

# --- Erinnerung ("nutzt du das noch?") ---------------------------------------
RECALL_ENABLED=true
RECALL_INTERVAL_DAYS=30
RECALL_ITEMS_PER_RECALL=3
RECALL_MIN_ITEM_AGE_DAYS=14

# --- Sonstiges ---------------------------------------------------------------
APP_NAME=Storder
PORT=8080
TZ=Europe/Berlin
SEED_BOXES=true
MAX_UPLOAD_MB=15
MAX_IMAGES_PER_ITEM=8
# DATA_DIR=./data
